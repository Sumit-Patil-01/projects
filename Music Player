class Song:
    def __init__(self, name):
        self.name = name
        self.next = None
        self.prev = None


class Playlist:
    def __init__(self):
        self.head = None

    # Add song
    def add_song(self, song_name):
        new_song = Song(song_name)

        if self.head is None:
            self.head = new_song
            print(f"{song_name} added to playlist.")
            return

        temp = self.head
        while temp.next:
            temp = temp.next

        temp.next = new_song
        new_song.prev = temp
        print(f"{song_name} added to playlist.")

    # Delete song
    def delete_song(self, song_name):
        temp = self.head

        while temp:
            if temp.name == song_name:
                if temp.prev:
                    temp.prev.next = temp.next
                else:
                    self.head = temp.next

                if temp.next:
                    temp.next.prev = temp.prev

                print(f"{song_name} deleted from playlist.")
                return

            temp = temp.next

        print("Song not found.")

    # Search song
    def search_song(self, song_name):
        temp = self.head
        position = 1

        while temp:
            if temp.name == song_name:
                print(f"{song_name} found at position {position}.")
                return
            temp = temp.next
            position += 1

        print("Song not found.")

    # Display forward
    def display_forward(self):
        temp = self.head
